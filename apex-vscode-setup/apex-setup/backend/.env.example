# ── App ───────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000

# ── MySQL (EC2 local o RDS) ──────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=apex_user
DB_PASS=tu_password_seguro
DB_NAME=apex_cloudworks

# ── Sessions ──────────────────────────────────────────────────
# Generar con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SESSION_SECRET=GENERAR_CON_COMANDO_ARRIBA

# ── Google Sheets API ─────────────────────────────────────────
# Opción A: Ruta al archivo de credenciales (local)
GOOGLE_KEY_FILE=./apex-cloudworks-jarvis-9921c54cedba.json
# Opción B: Credenciales como JSON en una línea (EC2 sin archivo)
GOOGLE_CREDENTIALS=
# ID de tu Spreadsheet
SHEETS_ID=1d4dVBf8Cb5m8sG72YWrEAUmpuBb7kxhYmrscHDh5cP0

# ── Email (Gmail App Password) ───────────────────────────────
# Activar en: myaccount.google.com/apppasswords
MAIL_USER=garettjohan12@gmail.com
MAIL_PASS=xxxx_xxxx_xxxx_xxxx

# ── Stripe ────────────────────────────────────────────────────
STRIPE_SECRET=sk_live_REEMPLAZAR
STRIPE_WEBHOOK_SECRET=whsec_REEMPLAZAR

# ── Telegram Bot (Jarvis) ─────────────────────────────────────
# Crear bot con @BotFather en Telegram
TELEGRAM_TOKEN=123456789:REEMPLAZAR
TELEGRAM_CHAT_ID=TU_CHAT_ID_NUMERICO

# ── Web Push VAPID ───────────────────────────────────────────
# Generar con: npx web-push generate-vapid-keys
VAPID_PUBLIC=REEMPLAZAR
VAPID_PRIVATE=REEMPLAZAR

# ── AWS S3 ───────────────────────────────────────────────────
# Usar IAM Role en EC2 en vez de keys cuando sea posible
AWS_REGION=us-east-1
AWS_BUCKET=apex-cloudworks-uploads
# Solo si no usás IAM Role:
# AWS_ACCESS_KEY_ID=REEMPLAZAR
# AWS_SECRET_ACCESS_KEY=REEMPLAZAR

# ── Admin ─────────────────────────────────────────────────────
ADMIN_EMAIL=garettjohan12@gmail.com
