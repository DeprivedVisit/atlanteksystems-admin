          <div class="stat-label">Tiempo de entrega</div>
        </div>
        <div class="stat-item">
          <div class="stat-num">$150</div>
          <div class="stat-label">Por landing</div>
        </div>
        <div class="stat-item">
          <div class="stat-num">100%</div>
